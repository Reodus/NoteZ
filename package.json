{
  "name": "notez",
  "version": "0.12.5",
  "description": "Bilingual notes with beautiful PDF export",
  "type": "module",
  "scripts": {
    "dev": "npm run fonts && npm run core && node electron/dev.mjs",
    "web": "vite",
    "core": "node scripts/core.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "vite build && npm run fonts && npm run core",
    "start": "electron .",
    "dist": "npm run build && electron-builder --linux",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "fonts": "node scripts/fonts.mjs",
    "test:asm": "node --experimental-strip-types scripts/test-asm.ts",
    "test:dir": "node --experimental-strip-types scripts/test-dir.ts"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/turndown": "^5.0.6",
    "codemirror": "^6.0.2",
    "d3-force": "^3.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.18.10",
    "lucide-solid": "^1.66.0",
    "mermaid": "^12.2.0",
    "solid-js": "^1.9.3",
    "turndown": "^7.2.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "electron-winstaller": false
  },
  "main": "electron/main.mjs",
  "author": {
    "name": "Reo",
    "email": "reodus.official@gmail.com"
  },
  "build": {
    "appId": "com.notez.app",
    "productName": "NoteZ",
    "executableName": "notez",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "core/typst-packages",
        "to": "typst-packages"
      },
      {
        "from": "core/fonts/noto",
        "to": "fonts"
      }
    ],
    "asar": true,
    "rpm": {
      "fpm": [
        "--rpm-compression-level",
        "6"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Bilingual notes with beautiful PDF export",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ],
      "extraResources": [
        {
          "from": "core/bin/notez-core",
          "to": "notez-core"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "core/bin/notez-core.exe",
          "to": "notez-core.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extraResources": [
        {
          "from": "core/bin/notez-core",
          "to": "notez-core"
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "typ"
          ],
          "name": "Note",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Reodus",
        "repo": "NoteZ"
      }
    ],
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "homepage": "https://github.com/Reodus/NoteZ",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reodus/NoteZ.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdfjs-dist": "^4.10.38"
  }
}
